# Copy to .env and fill in. .env is git-ignored; never commit it.

# ---- Admin login (the only account; there is no sign-up) ----
ADMIN_USERNAME=admin
# bcrypt hash of the password. Generate it with:
#   cd backend && .venv/bin/python -m app.auth hash-password
# Keep the single quotes: the hash contains $ signs, which would otherwise be expanded.
ADMIN_PASSWORD_HASH=''
# Random, 32+ characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Keep true when served over HTTPS. Set false only for plain-http local testing (Safari needs it).
COOKIE_SECURE=true

# ---- Database (docker compose) ----
POSTGRES_PASSWORD=

# ---- Ulai Voice Infra ----
ULAI_API_KEY=
ULAI_API_URL=https://backend.ulai.co.in
ULAI_CP_URL=https://cp.ulai.co.in
# The agent server ulai-agents connects to: https://host[:port] uses TLS, http://host:port doesn't.
ULAI_AGENT_URL=https://stgags.ulai.co
# Only if the agent server uses a different key than ULAI_API_KEY.
ULAI_AGENT_API_KEY=
# Sent to the SIP originate service as X-System-Secret, if it requires one.
ULAI_SYSTEM_SECRET=
ULAI_SIP_ORIGINATE_URL=http://148.113.59.189:8082/sip/originate

# ---- Web call connectivity (TURN credentials stay server-side) ----
# JSON lists.
STUN_URLS=["stun:stun.l.google.com:19302"]
TURN_URLS=[]
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Gemini (via Ulai's hosted agents) ----
# The service account key goes in credentials/google-service-account.json (git-ignored).
GEMINI_LOCATION=us-central1

# ---- Calls ----
RING_TIMEOUT_SECONDS=45

# ---- Build ----
# Where the ulai-api Python SDK checkout lives (used as a Docker build context).
# ULAI_SDK_PATH=../ulai-cloud-python-sdk
# STUDIO_PORT=3000
